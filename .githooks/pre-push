#!/bin/sh
set -eu
if command -v python >/dev/null 2>&1; then
    exec python scripts/check-secrets.py --history
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/check-secrets.py --history
else
    echo 'Secret check cannot run: Python is required. Push stopped.' >&2
    exit 1
fi
